rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catalogue — public read (storefront), admin-only write.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /store/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — created by any signed-in client, read by admin or any
    // signed-in client (phone identity isn't tied to the Firebase auth
    // session since OTP verification happens client-side — see note below).
    match /orders/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || request.auth != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Customer profile + saved addresses + cart — keyed by phone number
    // (not uid) so the same phone sees the same data on any device. Since
    // OTP verification happens client-side (2Factor.in) rather than through
    // Firebase Phone Auth, there is no cryptographic link between a
    // verified phone and this Firestore session, so any signed-in
    // (anonymous) client can read/write any phone's document. Accepted
    // tradeoff for this app's scale — do not store sensitive data here.
    match /users/{phone} {
      allow read, write: if request.auth != null;
    }

    // Admin phone allow-list — seeded manually from the Firebase console.
    // Readable so the app can check membership; never client-writable.
    match /adminPhones/{phone} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admin audit doc — a signed-in user may only claim admin for themself,
    // and only if their phone is on the adminPhones allow-list.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        exists(/databases/$(database)/documents/adminPhones/$(request.resource.data.phone));
      allow delete: if false;
    }
  }
}
